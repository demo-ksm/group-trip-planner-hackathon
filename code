#include <iostream>
#include <vector>
#include <string>
#include <set>
#include <map>
#include <algorithm>
#include <sstream>
#include <climits>
#include <limits>

using namespace std;

struct User {
    string name;
    int budget;
    int energy;
    set<string> tags;
    bool active = true;
};

struct Activity {
    int id;
    string name;
    int cost;
    int duration;
    int energy;
    string tag;
};

struct Input {
    int N, D, H;
    vector<User> users;
    map<int, Activity> activities;
    vector<string> events;
};

struct ParsedEvent {
    int originalIndex;
    int day;
    string type;
    string rawLine;
};

struct DayPlan {
    vector<int> ids;
    int cost = 0;
    int sat = 0;
};

static Input readInput() {
    Input in;
    if (!(cin >> in.N >> in.D >> in.H)) return in;
    in.users.resize(in.N);
    for (int i = 0; i < in.N; i++) {
        int k;
        cin >> in.users[i].name >> in.users[i].budget >> in.users[i].energy >> k;
        for (int j = 0; j < k; j++) {
            string t; cin >> t;
            in.users[i].tags.insert(t);
        }
        in.users[i].active = true;
    }
    int A; cin >> A;
    for (int i = 0; i < A; i++) {
        Activity a;
        cin >> a.id >> a.name >> a.cost >> a.duration >> a.energy >> a.tag;
        in.activities[a.id] = a;
    }
    int E; cin >> E;
    cin.ignore(numeric_limits<streamsize>::max(), '\n');
    for (int i = 0; i < E; i++) {
        string line;
        if (!getline(cin, line)) break;
        while (!line.empty() && (line.back() == '\r' || line.back() == ' ')) line.pop_back();
        in.events.push_back(line);
    }
    return in;
}

static string formatDay(int day, const vector<int>& ids, int cost, int sat) {
    if (ids.empty()) {
        return "Day " + to_string(day) + ": REST | cost=0 satisfaction=0";
    }
    vector<int> sorted_ids = ids;
    sort(sorted_ids.begin(), sorted_ids.end());
    string s = "Day " + to_string(day) + ": ";
    for (size_t i = 0; i < sorted_ids.size(); i++) {
        if (i) s += ' ';
        s += to_string(sorted_ids[i]);
    }
    s += " | cost=" + to_string(cost) + " satisfaction=" + to_string(sat);
    return s;
}

static DayPlan bestSubset(
    const vector<User>& users,
    const map<int, Activity>& activities,
    const set<int>& used,
    const set<string>& blockedTags,
    int H
) {
    vector<Activity> avail;
    for (auto const& [id, a] : activities) {
        if (used.count(id)) continue;
        if (blockedTags.count(a.tag)) continue;
        avail.push_back(a);
    }

    DayPlan best;
    int bestSat = -1;
    int bestCost = INT_MAX;
    vector<int> bestIds;
    int activeCount = 0;
    int minBudget = INT_MAX;
    int minEnergy = INT_MAX;

    for (auto const& u : users) {
        if (!u.active) continue;
        activeCount++;
        minBudget = min(minBudget, u.budget);
        minEnergy = min(minEnergy, u.energy);
    }

    if (activeCount == 0) return best;

    int n = avail.size();
    long long maxMask = 1LL << n;
    for (long long mask = 0; mask < maxMask; mask++) {
        int cost = 0;
        int dur = 0;
        int energy = 0;
        int sat = 0;
        vector<int> ids;

        for (int j = 0; j < n; j++) {
            if (mask & (1LL << j)) {
                auto const& a = avail[j];
                ids.push_back(a.id);
                cost += a.cost;
                dur += a.duration;
                energy += a.energy;
                for (auto const& u : users) {
                    if (u.active && u.tags.count(a.tag)) {
                        sat++;
                    }
                }
            }
        }

        if (cost > minBudget || energy > minEnergy || dur > H) {
            continue;
        }

        sort(ids.begin(), ids.end());
        bool better = false;
        if (sat > bestSat) {
            better = true;
        } else if (sat == bestSat && cost < bestCost) {
            better = true;
        } else if (sat == bestSat && cost == bestCost && ids < bestIds) {
            better = true;
        }

        if (better) {
            bestSat = sat;
            bestCost = cost;
            bestIds = ids;
            best.ids = ids;
            best.cost = cost;
            best.sat = sat;
        }
    }

    return best;
}

static vector<User> usersForDay(
    const vector<User>& baseUsers,
    const vector<ParsedEvent>& parsedEvents,
    int upToEventIndex,
    int queryDay
) {
    vector<User> users = baseUsers;

    vector<ParsedEvent> applicable;
    for (const auto& pe : parsedEvents) {
        if (pe.originalIndex <= upToEventIndex && pe.day <= queryDay) {
            applicable.push_back(pe);
        }
    }
    sort(applicable.begin(), applicable.end(), [](const ParsedEvent& a, const ParsedEvent& b) {
        if (a.day != b.day) return a.day < b.day;
        return a.originalIndex < b.originalIndex;
    });

    for (const auto& pe : applicable) {
        stringstream tmp(pe.rawLine);
        string type; int day;
        tmp >> type >> day;

        if (type == "DROP") {
            string name; tmp >> name;
            for (auto& u : users) if (u.name == name) u.active = false;
        } else if (type == "FATIGUE") {
            string name; int x; tmp >> name >> x;
            for (auto& u : users) if (u.name == name) u.energy = x;
        } else if (type == "BUDGET") {
            string name; int x; tmp >> name >> x;
            for (auto& u : users) if (u.name == name) u.budget = x;
        }
    }
    return users;
}

static set<string> blockedForDay(
    const vector<ParsedEvent>& parsedEvents,
    int upToEventIndex,
    int queryDay
) {
    set<string> blocked;
    for (const auto& pe : parsedEvents) {
        if (pe.originalIndex <= upToEventIndex && pe.type == "WEATHER" && pe.day == queryDay) {
            stringstream tmp(pe.rawLine);
            string type; int day; string tag;
            tmp >> type >> day >> tag;
            blocked.insert(tag);
        }
    }
    return blocked;
}

static vector<DayPlan> buildPlans(
    int startDay, int D, int H,
    const vector<User>& baseUsers,
    const map<int, Activity>& activities,
    const vector<ParsedEvent>& parsedEvents,
    int upToEventIndex,
    set<int> used,
    const vector<DayPlan>& prevPlans
) {
    vector<DayPlan> plans(D + 1);
    for (int d = 1; d < startDay; d++) {
        plans[d] = prevPlans[d];
    }
    for (int day = startDay; day <= D; day++) {
        vector<User> dayUsers = usersForDay(baseUsers, parsedEvents, upToEventIndex, day);
        set<string> dayBlocked = blockedForDay(parsedEvents, upToEventIndex, day);
        auto plan = bestSubset(dayUsers, activities, used, dayBlocked, H);
        plans[day] = plan;
        for (int x : plan.ids) {
            used.insert(x);
        }
    }
    return plans;
}

static string solve(Input in) {
    string out;

    vector<ParsedEvent> parsedEvents;
    for (size_t i = 0; i < in.events.size(); i++) {
        stringstream ss(in.events[i]);
        string type; int day;
        if (ss >> type >> day) {
            parsedEvents.push_back({static_cast<int>(i + 1), day, type, in.events[i]});
        }
    }

    vector<DayPlan> dummyPrev(in.D + 1);
    vector<DayPlan> initialPlans = buildPlans(
        1, in.D, in.H,
        in.users, in.activities,
        parsedEvents, 0,
        {}, dummyPrev
    );

    out += "=== PLAN ===\n";
    for (int d = 1; d <= in.D; d++) {
        out += formatDay(d, initialPlans[d].ids, initialPlans[d].cost, initialPlans[d].sat) + "\n";
    }

    vector<DayPlan> latestPlans = initialPlans;

    for (size_t e = 0; e < in.events.size(); e++) {
        int currentOriginalIndex = static_cast<int>(e + 1);
        out += "=== EVENT " + to_string(currentOriginalIndex) + ": " + in.events[e] + " ===\n";

        int targetDay = -1;
        for (const auto& pe : parsedEvents) {
            if (pe.originalIndex == currentOriginalIndex) {
                targetDay = pe.day;
                break;
            }
        }

        if (targetDay < 1 || targetDay > in.D) continue;

        set<int> usedBefore;
        for (int d = 1; d < targetDay; d++) {
            for (int id : latestPlans[d].ids) {
                usedBefore.insert(id);
            }
        }

        vector<DayPlan> newPlans = buildPlans(
            targetDay, in.D, in.H,
            in.users, in.activities,
            parsedEvents, currentOriginalIndex,
            usedBefore, latestPlans
        );

        for (int d = targetDay; d <= in.D; d++) {
            out += formatDay(d, newPlans[d].ids, newPlans[d].cost, newPlans[d].sat) + "\n";
        }

        latestPlans = newPlans;
    }

    return out;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    Input in = readInput();
    cout << solve(in);
    return 0;
}
